<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Group Chat · SignalR</title>
    <!-- Bootstrap 5 + Font Awesome for icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
            /* subtle background & card refinement */
            body {
                background: linear-gradient(145deg, #f7f9fc 0%, #eef1f6 100%);
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;
            }

            .chat-wrapper {
                max-width: 720px;
                margin: auto;
                background: white;
                border-radius: 2rem;
                box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.2), 0 4px 18px rgba(0, 0, 0, 0.05);
                padding: 2rem 2rem 1.8rem;
                transition: all 0.2s ease;
            }

            h2 {
                font-weight: 600;
                font-size: 1.8rem;
                letter-spacing: -0.02em;
                color: #1a2639;
                display: flex;
                align-items: center;
                gap: 0.6rem;
            }

                h2 i {
                    color: #3b7cff;
                    font-size: 2rem;
                }

            .card {
                border: none;
                border-radius: 1.25rem;
                background: #f9fbfe;
                box-shadow: inset 0 1px 3px rgba(0,0,0,0.02), 0 4px 12px rgba(0, 0, 0, 0.02);
                transition: box-shadow 0.15s;
            }

                .card:hover {
                    box-shadow: inset 0 1px 3px rgba(0,0,0,0.02), 0 8px 18px rgba(0, 0, 0, 0.04);
                }

            .form-label {
                font-weight: 500;
                font-size: 0.85rem;
                text-transform: uppercase;
                letter-spacing: 0.03em;
                color: #4d5b73;
                margin-bottom: 0.35rem;
            }

            .form-control, .input-group .form-control {
                border-radius: 0.85rem;
                border: 1px solid #e1e6ef;
                padding: 0.7rem 1.1rem;
                background: white;
                font-size: 0.95rem;
                transition: border 0.15s, box-shadow 0.15s;
            }

                .form-control:focus {
                    border-color: #3b7cff;
                    box-shadow: 0 0 0 4px rgba(59, 124, 255, 0.12);
                    outline: none;
                }

            .input-group .btn {
                border-radius: 0.85rem;
                padding: 0.7rem 1.4rem;
                font-weight: 500;
                letter-spacing: 0.01em;
                transition: all 0.15s;
                margin-left: 0.5rem;
                border: none;
            }

            .btn-primary {
                background: #2c5cf0;
                box-shadow: 0 6px 14px -6px rgba(44, 92, 240, 0.4);
            }

                .btn-primary:hover {
                    background: #1a4ad0;
                    transform: translateY(-1px);
                    box-shadow: 0 10px 18px -6px rgba(44, 92, 240, 0.5);
                }

            .btn-success {
                background: #1b9e5c;
                box-shadow: 0 6px 14px -6px rgba(27, 158, 92, 0.4);
            }

                .btn-success:hover:not(:disabled) {
                    background: #148a4e;
                    transform: translateY(-1px);
                    box-shadow: 0 10px 18px -6px rgba(27, 158, 92, 0.5);
                }

            .btn:disabled {
                opacity: 0.55;
                box-shadow: none;
                transform: none;
                cursor: not-allowed;
            }

            #messagesList {
                max-height: 380px;
                overflow-y: auto;
                border-radius: 1rem;
                background: white;
                padding: 0.5rem 0.25rem;
                margin-bottom: 0;
                scroll-behavior: smooth;
                box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.02);
            }

                #messagesList::-webkit-scrollbar {
                    width: 5px;
                }

                #messagesList::-webkit-scrollbar-track {
                    background: #f0f3f9;
                    border-radius: 10px;
                }

                #messagesList::-webkit-scrollbar-thumb {
                    background: #b7c3d6;
                    border-radius: 10px;
                }

            .list-group-item {
                border: none;
                background: transparent;
                padding: 0.6rem 1rem;
                border-radius: 0.75rem !important;
                margin-bottom: 0.2rem;
                font-size: 0.95rem;
                line-height: 1.4;
                word-break: break-word;
                transition: background 0.1s;
            }

                .list-group-item:not(.system-message) {
                    background: #f7faff;
                    border-left: 4px solid #3b7cff;
                }

                .list-group-item.system-message {
                    background: #f2f5fa;
                    color: #5e6f8d;
                    font-style: italic;
                    border-left: 4px solid #a0b3cc;
                    font-size: 0.9rem;
                }

                .list-group-item strong {
                    color: #1f2a44;
                    font-weight: 600;
                    margin-right: 0.35rem;
                }

            .chat-log-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin: 1.5rem 0 0.8rem 0;
            }

                .chat-log-header h4 {
                    font-weight: 600;
                    font-size: 1.2rem;
                    color: #1a2639;
                    margin: 0;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                    .chat-log-header h4 i {
                        color: #3b7cff;
                        font-size: 1.2rem;
                    }

            .badge-room {
                background: #e9eefa;
                color: #2351b0;
                font-weight: 500;
                padding: 0.3rem 0.9rem;
                border-radius: 30px;
                font-size: 0.8rem;
                letter-spacing: 0.01em;
            }
            /* smooth transition for disabled inputs */
            #messageInput:disabled, #sendButton:disabled {
                background-color: #f1f4fa;
                border-color: #e3e8f2;
            }

            .input-group .btn i {
                margin-right: 0.4rem;
            }
    </style>
</head>
<body>
    <div class="chat-wrapper">
        <!-- Header -->
        <h2>
            <i class="fas fa-comment-dots"></i> SignalR Group Chat
        </h2>

        <!-- identity & room card -->
        <div class="card p-3 mt-3 mb-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label"><i class="far fa-user me-1"></i>Username</label>
                    <input type="text" id="userInput" class="form-control" placeholder="e.g. Alex" />
                </div>
                <div class="col-md-6">
                    <label class="form-label"><i class="fas fa-door-open me-1"></i>Chat Room</label>
                    <div class="input-group">
                        <input type="text" id="roomInput" class="form-control" placeholder="e.g. DevTeam" />
                        <button id="joinButton" class="btn btn-primary">
                            <i class="fas fa-sign-in-alt"></i> Join
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- message composer card -->
        <div class="card p-3 mb-3">
            <label class="form-label"><i class="far fa-paper-plane me-1"></i>Message</label>
            <div class="input-group">
                <input type="text" id="messageInput" class="form-control" placeholder="Type a message..." disabled />
                <button id="sendButton" class="btn btn-success" disabled>
                    <i class="fas fa-paper-plane"></i> Send
                </button>
            </div>
        </div>

        <!-- chat log header with dynamic room badge (optional) -->
        <div class="chat-log-header">
            <h4><i class="fas fa-comments"></i> Chat Log</h4>
            <span id="roomBadge" class="badge-room d-none"><i class="fas fa-hashtag"></i> <span id="roomNameDisplay"></span></span>
        </div>

        <!-- messages list -->
        <ul id="messagesList" class="list-group"></ul>
    </div>

    <!-- SignalR JavaScript Client -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
            (function() {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/chatHub")
                    .build();

                let currentRoom = "";

                // DOM elements
                const messagesList = document.getElementById("messagesList");
                const userInput = document.getElementById("userInput");
                const roomInput = document.getElementById("roomInput");
                const messageInput = document.getElementById("messageInput");
                const sendButton = document.getElementById("sendButton");
                const joinButton = document.getElementById("joinButton");
                const roomBadge = document.getElementById("roomBadge");
                const roomNameDisplay = document.getElementById("roomNameDisplay");

                // Helper: scroll chat to bottom smoothly
                function scrollToBottom() {
                    messagesList.scrollTop = messagesList.scrollHeight;
                }

                // Helper: safely escape HTML (we'll use textContent instead of innerHTML for user content, but keep strong for display)
                // However the original used innerHTML; we improve security by building DOM nodes.
                // We'll use textContent for message body and create strong element for user.
                // But the original used innerHTML – we'll keep similar but safer: create elements.

                // --- SignalR event handlers ---
                connection.on("ReceiveGroupMessage", (user, message) => {
                    console.log("Group message received:", user, message);
                    const li = document.createElement("li");
                    li.className = "list-group-item";

                    const strong = document.createElement("strong");
                    strong.textContent = user + ":";
                    li.appendChild(strong);

                    // add space and message as text node (prevents XSS)
                    li.appendChild(document.createTextNode(" " + message));

                    messagesList.appendChild(li);
                    scrollToBottom();
                });

                connection.on("ReceiveSystemMessage", (message) => {
                    console.log("System msg: " + message);
                    const li = document.createElement("li");
                    li.className = "list-group-item system-message";
                    li.textContent = message;
                    messagesList.appendChild(li);
                    scrollToBottom();
                });

                // Start connection
                connection.start()
                    .then(() => console.log("SignalR connected."))
                    .catch(err => console.error("Connection failed: ", err.toString()));

                // --- Join room handler ---
                joinButton.addEventListener("click", async () => {
                    const room = roomInput.value.trim();
                    const user = userInput.value.trim();

                    if (!room || !user) {
                        alert("Please enter both username and room name.");
                        return;
                    }

                    // if already in a room, leave first
                    if (currentRoom) {
                        try {
                            await connection.invoke("LeaveRoom", currentRoom, user);
                        } catch (err) {
                            console.error("LeaveRoom error:", err);
                        }
                    }

                    currentRoom = room;

                    try {
                        await connection.invoke("JoinRoom", room, user);
                    } catch (err) {
                        console.error("JoinRoom error:", err);
                        alert("Failed to join room. See console for details.");
                        return;
                    }

                    // Clear chat and enable input
                    messagesList.innerHTML = "";
                    messageInput.disabled = false;
                    sendButton.disabled = false;
                    messageInput.focus();

                    // show room badge
                    roomNameDisplay.textContent = room;
                    roomBadge.classList.remove("d-none");
                });

                // --- Send message handler ---
                sendButton.addEventListener("click", async () => {
                    const user = userInput.value.trim();
                    const message = messageInput.value.trim();

                    if (currentRoom && message) {
                        try {
                            await connection.invoke("SendMessage", currentRoom, user, message);
                            messageInput.value = "";
                            messageInput.focus();
                        } catch (err) {
                            console.error("SendMessage error:", err);
                            alert("Failed to send message. See console.");
                        }
                    }
                });

                // --- Optional: allow Enter key in message input to send ---
                messageInput.addEventListener("keypress", (e) => {
                    if (e.key === "Enter" && !sendButton.disabled) {
                        e.preventDefault();
                        sendButton.click();
                    }
                });

                // --- Optional: if user changes username or room after joining, they should re-join.
                // We keep it simple as original design – no auto-leave on input change.
            })();
    </script>
</body>
</html>